# Server-only production settings (configure these in Vercel, never commit values).
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/prerna_foundation?retryWrites=true&w=majority
JWT_SECRET=<generate-a-long-random-secret>

# Razorpay: the key ID is returned only by the server after an order is created.
RAZORPAY_KEY_ID=rzp_test_or_live_key_id
RAZORPAY_KEY_SECRET=razorpay_key_secret

# SMTP is optional for contact notifications and donation receipts.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=smtp_username
SMTP_PASSWORD=smtp_password
FROM_EMAIL=no-reply@example.org
ADMIN_EMAIL=admin@example.org

# Public site URL used only for sitemap and robots metadata.
NEXT_PUBLIC_SITE_URL=https://www.example.org
